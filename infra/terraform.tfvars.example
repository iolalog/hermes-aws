# All secrets are stored in AWS SSM Parameter Store and fetched at boot — NOT Terraform variables.
# Store them once before deploying (see docs/setup.md step 3):
#   /hermes/slack-bot-token      (xoxb-...)
#   /hermes/slack-app-token      (xapp-...)
#   /hermes/anthropic-api-key    (sk-ant-...)
#   /hermes/openrouter-api-key   (sk-or-...)
#   /hermes/tavily-api-key       (tvly-...)   — web search
#   /hermes/github-token         (ghp_...)    — Skills Hub rate limit (optional)
#
# Memory repo: iolalog/hermes-memory (private)
# After deploy, add the generated /root/.ssh/hermes_memory.pub as a deploy key with write access.

aws_region = "eu-north-1"

# ── Peer monitoring (optional) ────────────────────────────────────────────────
# Uncomment to grant this instance permission to SSM into a peer agent for health checks.
# See openclaw-aws docs/peer-monitoring.md for the full setup pattern.
# peer_instance_id    = "i-0abc1234567890def"   # EC2 instance ID of the peer
# peer_aws_account_id = ""                        # leave empty if same AWS account
